# ─────────────────────────────────────────────────────────────
# Google SEO Automation — шаблон окружения
#   cp .env.example .env    и заполни значения
# Файл .env в .gitignore — НЕ коммитить реальные ключи.
# ─────────────────────────────────────────────────────────────

# ── Google Cloud ──────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=
# Путь к service-account JSON (для автоматизаций без UI)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ── Идентификаторы ресурсов ───────────────────────────────────
# Формат ВАЖЕН: GA4 требует префикс properties/
# Пример: GA4_PROPERTY_ID=properties/123456789
GA4_PROPERTY_ID=
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
GSC_SITE_URL=https://example.com/

# ── OAuth 2.0 (для действий от имени пользователя) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Google Ads ────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# ── Microsoft Advertising (Bing Ads) ──────────────────────────
MS_ADS_DEVELOPER_TOKEN=
MS_ADS_CLIENT_ID=
MS_ADS_CLIENT_SECRET=
MS_ADS_REFRESH_TOKEN=
MS_ADS_CUSTOMER_ID=
MS_ADS_ACCOUNT_ID=

# ── Hyper MCP (опционально; даёт доступ к Ads/GA4/GTM/GSC/BigQuery) ──
HYPER_API_KEY=
HYPER_WORKSPACE_ID=

# ── OpenChamber ───────────────────────────────────────────────
OPENCHAMBER_API_KEY=
OPENCHAMBER_PROJECT_ID=google-seo-automation

# ── Векторный поиск (F002; необязательно — есть FTS5) ─────────
# USE_LOCAL_EMBEDDINGS=true  — используем локальную модель, без внешнего API
# USE_LOCAL_EMBEDDINGS=false — потребуется OPENAI_API_KEY
USE_LOCAL_EMBEDDINGS=true
OPENAI_API_KEY=

# ── База ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/wiki.db

# ── Расписание (cron, серверное время) ────────────────────────
# Вики: раз в 14 дней в 02:00
WIKI_REFRESH_CRON=0 2 */14 * *
# Ежедневный отчёт GA4+GSC: 06:00
DAILY_REPORT_CRON=0 6 * * *
# Еженедельный AEO-аудит: понедельник 07:00
WEEKLY_AEO_CRON=0 7 * * 1

# ── Безопасность (обязательно для скриптов с мутациями) ───────
# Скрипты по умолчанию работают в dry-run.
# Поставьте 1 только когда сознательно разрешаете мутации.
ALLOW_MUTATIONS=0
# Максимум трат Google Ads в микро-USD за операцию (5000000 = $5)
ADS_MAX_MUTATION_MICROS=5000000