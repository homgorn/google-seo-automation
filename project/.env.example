# ─────────────────────────────────────────────────────────────
# Google SEO Automation — шаблон окружения
#   cp .env.example .env    и заполни значения
# Файл .env в .gitignore — НЕ коммитить реальные ключи.
#
# ПОЛЯ, КОТОРЫЕ РЕАЛЬНО ЧИТАЕТ КОД (проверено 2026-11-11):
#   GOOGLE_APPLICATION_CREDENTIALS, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#   GOOGLE_REFRESH_TOKEN, GSC_SITE_URL, GSC_SITEMAP_PATH,
#   ALLOW_MUTATIONS, ADS_MAX_MUTATION_MICROS
#
# ПОЛЯ, КОТОРЫЕ ЧИТАЮТСЯ ТОЛЬКО ЧЕРЕЗ os.environ — см. .env.example ниже.
# ─────────────────────────────────────────────────────────────

# ── Google Cloud ──────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=
# Путь к service-account JSON (для автоматизаций без UI).
# Метод аутентификации: service_account | oauth (аргумент --auth-method)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ── Идентификаторы ресурсов ───────────────────────────────────
# ВАЖНО: GA4 требует префикс properties/
# Пример: GA4_PROPERTY_ID=properties/123456789
GA4_PROPERTY_ID=
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
# Формат: https://example.com/  (с протоколом и слэшем)
GSC_SITE_URL=
# Путь sitemap внутри сайта (для sitemaps.submit)
GSC_SITEMAP_PATH=/sitemap.xml

# ── OAuth 2.0 (альтернатива service account) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Google Ads ────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# ── Microsoft Advertising (Bing Ads) ──────────────────────────
MS_ADS_DEVELOPER_TOKEN=
MS_ADS_CLIENT_ID=
MS_ADS_CLIENT_SECRET=
MS_ADS_REFRESH_TOKEN=
MS_ADS_CUSTOMER_ID=
MS_ADS_ACCOUNT_ID=

# ── OpenChamber ───────────────────────────────────────────────
OPENCHAMBER_API_KEY=
OPENCHAMBER_PROJECT_ID=google-seo-automation

# ── Эмбеддинги (опционально; по умолчанию FTS5 без внешних API) ──
USE_LOCAL_EMBEDDINGS=true
OPENAI_API_KEY=

# ── База ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/wiki.db

# ── Расписание (cron, серверное время) ────────────────────────
WIKI_REFRESH_CRON=0 2 */14 * *
DAILY_REPORT_CRON=0 6 * * *
WEEKLY_AEO_CRON=0 7 * * 1

# ─────────────────────────────────────────────────────────────
# БЕЗОПАСНОСТЬ — управление мутациями
# ─────────────────────────────────────────────────────────────
# Мутации внешнего состояния (создание кампании, публикация версии GTM,
# отправка URL в Indexing API) запрещены по умолчанию.
# Поставьте 1 только когда сознательно разрешаете.
# Проверяется в scripts/common.py -> check_mutation_allowed()
ALLOW_MUTATIONS=0
# Потолок одной мутации в микросах (5000000 = $5). 0 = без ограничений.
ADS_MAX_MUTATION_MICROS=5000000
